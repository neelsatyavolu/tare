{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tare",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "tare", "database_id": "e1f94abe-16c5-4650-9703-66c0ed8d1aa7", "migrations_dir": "migrations" }
  ],
  "ai": { "binding": "AI" },
  "ratelimits": [
    // Sign-up form: 5 posts per minute per IP, so nobody can use it to mail-bomb an address.
    { "name": "SIGNUP_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  // Detailed briefings run on a queue: they take a minute or two, longer than a page request should wait.
  "queues": {
    "producers": [{ "binding": "BRIEFING_QUEUE", "queue": "tare-briefings" }],
    "consumers": [{ "queue": "tare-briefings", "max_batch_size": 2, "max_batch_timeout": 1, "max_retries": 1 }]
  },
  "triggers": {
    "crons": [
      // Hourly: pull every feed (most only hold their latest 20-50 items), then refresh today's edition.
      "7 * * * *",
      // 11:00 UTC: email it (7 a.m. New York in summer, 6 a.m. in winter); 13:00 resumes anyone missed.
      "0 11 * * *",
      "0 13 * * *"
    ]
  },
  "limits": { "cpu_ms": 120000 },
  // Public only through the custom domain; no *.workers.dev address.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "tare.news", "custom_domain": true }],
  "vars": {
    "APP_URL": "https://tare.news",
    "MAIL_FROM": "Tare <edition@tare.news>"
  },
  "observability": { "enabled": true }
}
